        "# ==========================================\n",
        "# TASK 2: Text Cleaning, Preprocessing and Data Quality, Target Analysis\n",
        "# ==========================================\n",
        "import re\n",
        "\n",
        "# 1 & 2. Check duplicate records and missing values before cleaning\n",
        "print(\"Number of duplicate records before cleaning:\", df.duplicated().sum())\n",
        "print(\"\\nNumber of missing values in each column:\\n\", df.isnull().sum())\n",
        "\n",
        "# Handle missing values and duplicate comments\n",
        "df = df.dropna()\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# 3. Clean the comment text function\n",
        "def clean_text(text):\n",
        "    if isinstance(text, str):\n",
        "        text = text.lower()  # Convert to lowercase\n",
        "        text = re.sub(r'<.*?>', '', text)  # Remove tags\n",
        "        text = re.sub(r'http\\S+|www\\S+|https\\S+', '', text, flags=re.MULTILINE)  # Remove URLs\n",
        "        text = re.sub(r'\\d+', '', text)  # Remove numbers\n",
        "        text = re.sub(r'[^\\w\\s]', '', text)  # Remove punctuation and special characters\n",
        "        text = re.sub(r'[^\\x00-\\x7F]+', '', text)  # Remove emojis / non-ascii\n",
        "        text = re.sub(r'\\s+', ' ', text).strip()  # Remove extra spaces\n",
        "        return text\n",
        "    return ''\n",
        "\n",
        "# Column names adjustment based on standard datasets (check your dataframe columns if needed)\n",
        "# Assuming comment column is named 'comment_text' or similar, let's auto-detect or use standard\n",
        "text_column = 'comment_text' if 'comment_text' in df.columns else df.columns[0]\n",
        "target_column = 'target' if 'target' in df.columns else df.columns[1]\n",
        "\n",
        "df['cleaned_comment'] = df[text_column].apply(clean_text)\n",
        "\n",
        "# Encode the toxicity labels\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "label_encoder = LabelEncoder()\n",
        "df['encoded_label'] = label_encoder.fit_transform(df[target_column])\n",
        "\n",
        "# Split data into training and testing sets\n",
        "from sklearn.model_selection import train_test_split\n",
        "X_train_text, X_test_text, y_train, y_test = train_test_split(\n",
        "    df['cleaned_comment'], df['encoded_label'], test_size=0.2, random_state=42\n",
        ")\n",
        "\n",
        "print(\"\\nTask 2 Completed Successfully!\")\n",
        "print(\"Cleaned data sample:\")\n",
        "print(df[['cleaned_comment', 'encoded_label']].head())\n"
